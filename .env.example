# Environment
CI_ENVIRONMENT = development

# App
app.baseURL = 'http://127.0.0.1:8081/'

# Database
# The local database user is 'root'; obtain the password through local configuration.
database.default.hostname = localhost
database.default.database = portal_db
database.default.username = root
database.default.password = YOUR_LOCAL_DB_PASSWORD
database.default.DBDriver = MySQLi
database.default.port = 3306

# Security (generate a real key for production)
encryption.key = base64:ChangeThisKeyForProduction1234567890123456789012345=

# Session
cookie.prefix = ''
cookie.domain = ''
cookie.path = /
